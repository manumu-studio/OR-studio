{
  "name": "or-studio",
  "version": "0.1.0",
  "description": "OR Studio — Architectural visualization portfolio with Payload CMS",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --require ./scripts/polyfill-file.cjs\" next build",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/polyfill-file.cjs\" next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/polyfill-file.cjs\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,json}\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/polyfill-file.cjs\" next start",
    "prepare": "husky",
    "seed": "tsx src/seed/index.ts",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build --no-cache",
    "docker:admin": "docker compose --profile admin up",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@payloadcms/db-mongodb": "3.79.0",
    "@payloadcms/next": "3.79.0",
    "@payloadcms/plugin-cloud-storage": "^3.79.0",
    "@payloadcms/richtext-lexical": "3.79.0",
    "@payloadcms/ui": "3.79.0",
    "cloudinary": "^2.9.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "^12.36.0",
    "graphql": "^16.8.1",
    "isomorphic-dompurify": "^3.3.0",
    "next": "15.4.11",
    "payload": "3.79.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.71.2",
    "sharp": "0.34.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "sass": "^1.80.0",
    "tsx": "^4.21.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
