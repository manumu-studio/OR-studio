# OR Studio v2 — Environment Variables
# Copy to .env and fill in values

# === Database ===
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/or-studio?retryWrites=true&w=majority

# === Payload CMS ===
PAYLOAD_SECRET=your-secret-key-min-32-chars

# === Server ===
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === Cloudinary (Packet 1) ===
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# === Email (Packet 8) ===
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=
