# OR Studio v2 — Docker local development environment variables
# Copy this file to .env.docker and fill in your credentials
# DO NOT use in production — these are local dev credentials only

# === Database (local MongoDB container) ===
# Using dev user created by mongo-init.js
MONGODB_URI=mongodb://or_studio_dev:or_studio_dev_password@mongodb:27017/or-studio

# === Payload CMS ===
# Must be at least 32 characters
PAYLOAD_SECRET=docker-dev-secret-change-me-in-production-min-32-chars

# === Server ===
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === Cloudinary (Image CDN) ===
# Get your credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
